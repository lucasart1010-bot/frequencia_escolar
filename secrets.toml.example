# Copie para .streamlit/secrets.toml (NÃO suba esse arquivo no GitHub)
# No Streamlit Community Cloud: App > Settings > Secrets (cole o mesmo conteúdo)

[supabase]
url = "https://SEU-PROJETO.supabase.co"
key = "SUA_CHAVE_SERVICE_ROLE"   # Supabase > Project Settings > API > service_role

# Opcional: protege o app com senha
[app]
senha = "troque-esta-senha"
